{
    "rewrites": [
        {
            "source": "/api/auth/(.*)",
            "destination": "/api/auth.js"
        },
        {
            "source": "/api/users/(.*)",
            "destination": "/api/users.js"
        },
        {
            "source": "/api/mentorship/(.*)",
            "destination": "/api/mentorship.js"
        },
        {
            "source": "/api/payment/(.*)",
            "destination": "/api/billing.js"
        },
        {
            "source": "/api/plans",
            "destination": "/api/billing.js"
        },
        {
            "source": "/api/dojos",
            "destination": "/api/gym.js"
        },
        {
            "source": "/api/modalities",
            "destination": "/api/gym.js"
        },
        {
            "source": "/api/schedules",
            "destination": "/api/gym.js"
        },
        {
            "source": "/api/contact",
            "destination": "/api/support.js"
        },
        {
            "source": "/api/health",
            "destination": "/api/support.js"
        },
        {
            "source": "/api/content/(.*)",
            "destination": "/api/content.js"
        },
        {
            "source": "/api/content",
            "destination": "/api/content.js"
        },
        {
            "source": "/api/users",
            "destination": "/api/users.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}