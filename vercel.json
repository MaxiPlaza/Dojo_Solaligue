{
    "rewrites": [
        {
            "source": "/api/auth/(.*)",
            "destination": "/api/auth.js"
        },
        {
            "source": "/api/users/(.*)",
            "destination": "/api/users.js"
        },
        {
            "source": "/api/mentorship/(.*)",
            "destination": "/api/mentorship.js"
        },
        {
            "source": "/api/payment/(.*)",
            "destination": "/api/payment.js"
        },
        {
            "source": "/api/content/(.*)",
            "destination": "/api/content.js"
        },
        {
            "source": "/api/content",
            "destination": "/api/content.js"
        },
        {
            "source": "/api/users",
            "destination": "/api/users.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}